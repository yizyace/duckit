{
  "name": "duckit",
  "version": "0.1.1",
  "description": "An offline Classic envelope budget for macOS",
  "author": "Duckit contributors",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "demo": "DUCKIT_DEMO=1 electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests scripts docs *.json *.ts *.yml .github",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.yml .github",
    "package:mac": "npm run runtime:fetch && npm run check && electron-builder --mac --arm64 --x64 --publish never",
    "runtime:fetch": "node scripts/runtime-fetch.ts",
    "test:transport": "node scripts/transport-proof.ts",
    "diagnostics": "tsx scripts/diagnostics.ts",
    "test:package": "tsx scripts/package-smoke.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "lossless-json": "4.3.1",
    "lucide-react": "1.41.0",
    "mysql2": "3.24.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
